    "file-viewer",
    "document-preview",
    "vanilla-js",
    "web-component",
    "full-preset",
    "office-preview",
    "cad-viewer",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer-web-full.git"
  },
  "homepage": "https://github.com/flyfish-dev/file-viewer-web-full",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer-web-full/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "file-viewer-copy-assets": "./scripts/copy-assets.mjs"
  },
  "unpkg": "./dist/flyfish-file-viewer-web-full.iife.js",
  "jsdelivr": "./dist/flyfish-file-viewer-web-full.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./amd": "./dist/flyfish-file-viewer-web-full.amd.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/copy-assets.mjs",
    "README.md",
    "README.en.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-iife.mjs && node scripts/build-copy-assets.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:github-258": "npm exec --yes --package playwright@1.61.1 --package requirejs@2.3.7 -- node scripts/verify-github-258.mjs"
  },
